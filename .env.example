# Leave LLM_API_KEY blank for fully playable mock mode.
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Gemini alternative:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-lite-latest
# gemini-2.5-flash returns 404 for new API keys; use the alias above.
ELEVENLABS_API_KEY=
# Optional error monitoring (frontend DSN is public; set before building Vite).
SENTRY_DSN=
VITE_SENTRY_DSN=
